<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnPhpunitDeprecation="true"
         failOnPhpunitNotice="true"
         cacheDirectory="var/.phpunit.cache">
    <php>
        <!-- Bundle defaults reference %env(APP_SECRET)%; the value is irrelevant to the assertions. -->
        <env name="APP_SECRET" value="nubit-integration-secret-key-at-least-32-bytes"/>
    </php>
    <testsuites>
        <testsuite name="platform">
            <directory>packages/platform/tests</directory>
        </testsuite>
        <testsuite name="api-platform">
            <directory>packages/api-platform/tests</directory>
        </testsuite>
        <testsuite name="admin-bundle">
            <directory>packages/admin-bundle/tests</directory>
        </testsuite>
        <testsuite name="tenant-bundle">
            <directory>packages/tenant-bundle/tests</directory>
        </testsuite>
        <testsuite name="sequence-bundle">
            <directory>packages/sequence-bundle/tests</directory>
        </testsuite>
        <testsuite name="workflow-bundle">
            <directory>packages/workflow-bundle/tests</directory>
        </testsuite>
        <!--
            Needs a real PostgreSQL server. Excluded from `composer test` so the
            unit suite stays runnable without Docker; `composer test-integration`
            provisions the database and runs it.
        -->
        <testsuite name="integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>packages/platform/src</directory>
            <directory>packages/api-platform/src</directory>
            <directory>packages/admin-bundle/src</directory>
            <directory>packages/tenant-bundle/src</directory>
            <directory>packages/sequence-bundle/src</directory>
            <directory>packages/workflow-bundle/src</directory>
        </include>
    </source>
</phpunit>
